; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="UrukDrive"
config/description="Original open-world driving game — third-person on-foot movement + drivable vehicles in a small procedurally-blocked-out city."
run/main_scene="res://scenes/World.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.058, 0.058, 0.09, 1)
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=1170
window/size/viewport_height=2532
window/handheld/orientation="landscape"
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.2,
"events": []
}
move_back={
"deadzone": 0.2,
"events": []
}
move_left={
"deadzone": 0.2,
"events": []
}
move_right={
"deadzone": 0.2,
"events": []
}
interact={
"deadzone": 0.2,
"events": []
}
brake={
"deadzone": 0.2,
"events": []
}

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_environment="res://assets/default_env.tres"
